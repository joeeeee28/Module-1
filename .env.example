# LearnMate — environment configuration
# Copy this file to `.env` (same directory) and fill in what you need.
# Real environment variables always take precedence over this file.
# `.env` is git-ignored — never commit secrets.

# --- server ---
PORT=4000
NODE_ENV=production
# SQLite database file (no separate DB server required). Keep on a persistent path.
DATABASE_PATH=./data/app.db
LOG_LEVEL=info
LOG_DIR=./data/logs

# Optional: stable secret for hashing session tokens. Set a long random value in
# production. Sessions also persist without it, so it's optional for single-machine use.
AUTH_SECRET=

# Demo seed (OFF by default). Set "true" to create a sample account
# (alex@example.com / demo) with realistic example data for first-time evaluation.
SEED_DEMO=false

# --- real AI model (optional) ---
# Unset = the built-in deterministic learning engine is used (no key needed).
# Set = the AI Coach and open-ended answers are generated by a real model.
# Keys are server-side only and NEVER reach the browser.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OR
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AI_TIMEOUT_MS=30000

# --- live web / resource discovery (optional) ---
# Used to discover current resources. Without it, the app uses live PyPI/npm
# lookups + a curated map of authoritative official documentation.
SEARCH_API_PROVIDER=               # tavily | brave | serp
SEARCH_API_KEY=

# --- notifications (real email + in-app) ---
# In-app notifications always work. Email uses a real transactional provider.
# NOTIFICATION_ENV=development enables a SAFE local "log" provider that writes
# emails to data/logs/email/ instead of sending (no real mailboxes touched).
# NOTIFICATION_ENV=production (default) requires a real provider below.
NOTIFICATION_ENV=production
EMAIL_PROVIDER=             # resend | sendgrid | smtp | log
EMAIL_API_KEY=              # for resend / sendgrid
EMAIL_FROM=                 # e.g. "LearnMate <noreply@example.com>"
EMAIL_FROM_NAME=LearnMate
# Base URL for deep links in emails (the app's public address).
APP_URL=http://localhost:4000

# SMTP provider settings (when EMAIL_PROVIDER=smtp):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- other optional notification transports ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=

# --- cron-triggered automation ---
# Protects POST /api/agent/cron/morning (called by an external scheduler).
ADMIN_TOKEN=

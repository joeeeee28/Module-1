# LearnMate — environment configuration
# Copy to .env (or set in your host's env vars). ALL are optional.

# --- server ---
PORT=4000
NODE_ENV=production
DATABASE_PATH=./data/app.db
LOG_LEVEL=info

# Demo seed (OFF by default). Set "true" to create a sample account
# (alex@example.com / demo) with realistic example data.
SEED_DEMO=false

# --- real AI model (optional) ---
# If unset, the built-in deterministic learning engine is used. When set, the
# AI Coach and open-ended answers are generated by a real model (server-side
# only — keys never reach the browser).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OR
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- live search / resource discovery (optional) ---
SEARCH_API_PROVIDER=        # tavily | brave | serp
SEARCH_API_KEY=

# --- notifications (optional transports) ---
# In-app notifications always work. These add real external delivery:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- cron-triggered automation ---
# Protects POST /api/agent/cron/morning (called by an external scheduler).
ADMIN_TOKEN=
